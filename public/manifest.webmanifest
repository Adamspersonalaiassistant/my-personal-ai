{
  "id": "/",
  "name": "Emery — Adam's Personal AI",
  "short_name": "Emery",
  "description": "Adam's private persistent personal AI companion.",
  "start_url": "/chat?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#071426",
  "theme_color": "#0b3f8f",
  "categories": ["productivity", "utilities"],
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Talk to Emery",
      "short_name": "Emery",
      "description": "Continue the same Emery conversation.",
      "url": "/chat?source=pwa-shortcut",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "HPO",
      "short_name": "HPO",
      "description": "Open the same HPO field workspace.",
      "url": "/hpo?source=pwa-shortcut",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Calendar",
      "short_name": "Calendar",
      "description": "Open Emery Calendar and tasks.",
      "url": "/calendar?source=pwa-shortcut",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Quick Capture",
      "short_name": "Capture",
      "description": "Send a quick thought into the same Emery conversation.",
      "url": "/capture?source=capture&input=typed",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
}
